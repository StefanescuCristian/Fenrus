FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build-env
WORKDIR /app

# Create a volume and copy the output to it
VOLUME /build

# Copy everything
COPY . ./
# sets the version
RUN chmod +x ./setversion.sh && ./setversion.sh
# Restore as distinct layers
RUN dotnet restore -p:SixLaborsLicenseKey="$SIXLABORS_LICENSE_KEY"
# Build and publish a release
CMD ["sh", "-c", "dotnet publish -c Release -o /build /app/Fenrus.csproj -p:SixLaborsLicenseKey=\"$SIXLABORS_LICENSE_KEY\""]
